# Public environment variables for the frontend (Next.js exposes NEXT_PUBLIC_* on the client)

# If unset, the app uses mock data so it works end-to-end without a backend.
NEXT_PUBLIC_API_BASE=

# Optional URLs
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_WS_URL=

# Runtime mode (defaults to development if unset)
NEXT_PUBLIC_NODE_ENV=development

# Logging level: silent | error | warn | info | debug
NEXT_PUBLIC_LOG_LEVEL=info

# Request timeout (ms)
NEXT_PUBLIC_TIMEOUT_MS=12000

# Healthcheck endpoint path
NEXT_PUBLIC_HEALTHCHECK_PATH=/api/health

# Feature flags as JSON object, e.g. {"newHeader":true}
NEXT_PUBLIC_FEATURE_FLAGS={}

# Experiments opt-in
NEXT_PUBLIC_EXPERIMENTS_ENABLED=false

# Network/server related (optional for static export or CI)
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_TRUST_PROXY=false

# For tooling/telemetry toggles
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=true
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
